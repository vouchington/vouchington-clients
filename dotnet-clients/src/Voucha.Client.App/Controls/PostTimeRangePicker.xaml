<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Voucha.Client.App.Controls.PostTimeRangePicker"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:posts="clr-namespace:Voucha.Client.Core.Posts;assembly=Voucha.Client.Core"
    x:Name="Root">
    <Picker x:Name="RangePicker"
        x:DataType="posts:PostTimeRangeSelection"
        AutomationId="post-time-range"
        Title="{DynamicResource extracted.posts.postTimeRangeSelect.label}"
        SemanticProperties.Description="{DynamicResource extracted.posts.postTimeRangeSelect.label}"
        ItemsSource="{Binding Options}"
        ItemDisplayBinding="{Binding Label, x:DataType=posts:PostTimeRangeOption}"
        SelectedItem="{Binding SelectedOption, Mode=OneWay}"
        SelectedIndexChanged="OnSelectedIndexChanged" />
</ContentView>
