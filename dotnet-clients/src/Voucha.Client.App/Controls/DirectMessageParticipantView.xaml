<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Voucha.Client.App.Controls.DirectMessageParticipantView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:messages="clr-namespace:Voucha.Client.Core.Messages;assembly=Voucha.Client.Core"
    x:DataType="messages:DirectMessageParticipantRow">
    <Grid ColumnDefinitions="36,*" ColumnSpacing="8">
        <Image AutomationId="direct-message-participant-avatar" HeightRequest="36" WidthRequest="36" Aspect="AspectFill"
               Source="{Binding ProfileImagePlacement, Converter={StaticResource ProfilePlacementImageSource96}}" />
        <VerticalStackLayout Grid.Column="1">
            <Label Text="{Binding Label}" Style="{StaticResource Body}" />
            <Label Text="{Binding Role}" Style="{StaticResource Metadata}" />
        </VerticalStackLayout>
    </Grid>
</ContentView>
