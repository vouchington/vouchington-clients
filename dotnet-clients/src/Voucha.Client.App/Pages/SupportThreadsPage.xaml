<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Voucha.Client.App.Pages.SupportThreadsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:app="clr-namespace:Voucha.Client.App"
    xmlns:chat="clr-namespace:Voucha.Client.Core.Chat;assembly=Voucha.Client.Core"
    xmlns:controls="clr-namespace:Voucha.Client.App.Controls"
    xmlns:pages="clr-namespace:Voucha.Client.App.Pages"
    x:DataType="chat:SupportThreadsViewModel"
    Title="{DynamicResource native.swift.support.support}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <pages:InvertedBooleanConverter x:Key="InvertedBooleanConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,Auto,*" Padding="20" RowSpacing="16">
        <VerticalStackLayout Spacing="6">
            <Label Text="{DynamicResource native.swift.support.support}" Style="{StaticResource Headline}" />
            <Label Text="{DynamicResource native.dotnet.support.listDescription}" Style="{StaticResource Metadata}" />
        </VerticalStackLayout>

        <Border
            Grid.Row="1"
            Padding="12"
            BackgroundColor="#FEF2F2"
            Stroke="#FCA5A5"
            StrokeThickness="1"
            IsVisible="{Binding HasError}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Label Text="{Binding ErrorMessage}" TextColor="#991B1B" Style="{StaticResource Body}" />
        </Border>

        <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*" RowSpacing="12">
            <VerticalStackLayout Spacing="8">
                <Entry x:Name="SubjectEntry" Placeholder="{DynamicResource native.swift.crmContacts.subject}" />
                <Editor x:Name="MessageEditor" Placeholder="{DynamicResource native.dotnet.support.optionalMessage}" AutoSize="TextChanges" MinimumHeightRequest="88" />
                <Entry x:Name="ConversationIdEntry" Placeholder="{DynamicResource native.dotnet.support.optionalConversationId}" />
                <Button Text="{DynamicResource native.swift.common.create}" Clicked="OnCreateClicked" IsEnabled="{Binding IsSubmitting, Converter={StaticResource InvertedBooleanConverter}}" />
            </VerticalStackLayout>

            <CollectionView
                Grid.Row="2"
                ItemsSource="{Binding Threads}"
                RemainingItemsThreshold="2"
                RemainingItemsThresholdReached="OnRemainingItemsThresholdReached">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="8">
                        <Label Text="{DynamicResource native.dotnet.support.listEmpty}" Style="{StaticResource Headline}" />
                        <Label Text="{DynamicResource native.dotnet.support.createDescription}" Style="{StaticResource Body}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="chat:SupportThreadRow">
                        <Border Margin="0,0,0,12" Padding="14" Stroke="#D8DEE9" StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding DisplaySubject}" Style="{StaticResource Headline}" />
                                <Label Text="{Binding LocalizedStatus}" Style="{StaticResource Eyebrow}" />
                                <Label Text="{app:UiLocalizedValue Path=CreatedAt, Format=dateTime}" Style="{StaticResource Metadata}" />
                                <Button Text="{DynamicResource native.swift.communityActions.open}" Clicked="OnOpenClicked" CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <controls:HybridPaginationControl
                        x:Name="PaginationControl"
                        PaginationId="support-threads"
                        HasMore="{Binding HasMore}"
                        IsLoading="{Binding IsLoading}"
                        HasError="{Binding HasError}" />
                </CollectionView.Footer>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
