<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Voucha.Client.App.Pages.TopicManagementPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Voucha.Client.App.Controls"
    Title="{DynamicResource native.dotnet.topicManagement.title}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Entry x:Name="NameEntry" Placeholder="{DynamicResource native.swift.communities.name}" />
            <Entry x:Name="SlugEntry" Placeholder="{DynamicResource native.swift.communities.slug}" />
            <Entry x:Name="TypeEntry" Placeholder="{DynamicResource native.swift.topicManagementFields.topicType}" Text="topic" />
            <controls:NativeMarkdownEditorView x:Name="MarkdownEditor" />
            <Entry x:Name="HostnameEntry" Placeholder="{DynamicResource native.swift.topicManagementFields.primaryHostname}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry x:Name="LogoImageEntry" Placeholder="{DynamicResource native.dotnet.topicManagement.logoImageId}" />
                <Button Grid.Column="1" Text="{DynamicResource native.dotnet.topicManagement.upload}" Clicked="OnUploadLogoClicked" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry x:Name="HeroImageEntry" Placeholder="{DynamicResource native.dotnet.topicManagement.heroImageId}" />
                <Button Grid.Column="1" Text="{DynamicResource native.dotnet.topicManagement.upload}" Clicked="OnUploadHeroClicked" />
            </Grid>
            <HorizontalStackLayout Spacing="8">
                <CheckBox x:Name="NoindexCheckBox" />
                <Label Text="{DynamicResource native.swift.topicManagementFields.noIndex}" VerticalOptions="Center" Style="{StaticResource Body}" />
                <CheckBox x:Name="AllowReviewsCheckBox" />
                <Label Text="{DynamicResource native.swift.topicManagementFields.allowReviews}" VerticalOptions="Center" Style="{StaticResource Body}" />
            </HorizontalStackLayout>
            <Button Text="{DynamicResource common.save}" Clicked="OnSaveClicked" />
            <Entry x:Name="AliasEntry" Placeholder="{DynamicResource native.swift.topicManagementFields.alias}" />
            <Button Text="{DynamicResource native.swift.topicManagementFields.addAlias}" Clicked="OnAddAliasClicked" />
            <Label x:Name="AliasesLabel" Style="{StaticResource Metadata}" />
            <controls:HybridPaginationControl
                x:Name="AliasesPaginationControl"
                PaginationId="topic-aliases"
                LoadNextPageRequested="OnLoadMoreAliasesRequested" />
            <Entry x:Name="AdditionalHostnameEntry" Placeholder="{DynamicResource native.swift.topicManagementFields.additionalHostname}" />
            <Button Text="{DynamicResource native.swift.topicManagementFields.addHostname}" Clicked="OnAddHostnameClicked" />
            <Label x:Name="HostnamesLabel" Style="{StaticResource Metadata}" />
            <controls:HybridPaginationControl
                x:Name="HostnamesPaginationControl"
                PaginationId="topic-additional-hostnames"
                LoadNextPageRequested="OnLoadMoreHostnamesRequested" />
            <Entry x:Name="MergeDestinationEntry" Placeholder="{DynamicResource native.dotnet.topicManagement.mergeDestination}" />
            <Button Text="{DynamicResource native.dotnet.topicManagement.mergeTopic}" Clicked="OnMergeClicked" />
            <HorizontalStackLayout Spacing="8">
                <Button Text="{DynamicResource native.dotnet.topicManagement.toggleSourceEnabled}" Clicked="OnToggleSourceEnabledClicked" />
                <Button Text="{DynamicResource native.dotnet.topicManagement.toggleSourceDiscoverable}" Clicked="OnToggleSourceDiscoverableClicked" />
            </HorizontalStackLayout>
            <Label x:Name="SourceLabel" Style="{StaticResource Metadata}" />
            <Label x:Name="StatusLabel" Style="{StaticResource Metadata}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
