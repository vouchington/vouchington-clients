<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Voucha.Client.App.Pages.ChatListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:app="clr-namespace:Voucha.Client.App"
    xmlns:chat="clr-namespace:Voucha.Client.Core.Chat;assembly=Voucha.Client.Core"
    xmlns:controls="clr-namespace:Voucha.Client.App.Controls"
    x:DataType="chat:ChatListViewModel"
    Title="{DynamicResource native.swift.routeMetadata.mainChatChatTitle}">
    <Grid RowDefinitions="Auto,Auto,*" Padding="20" RowSpacing="16">
        <VerticalStackLayout Spacing="6">
            <Label Text="{DynamicResource native.swift.routeMetadata.mainChatChatTitle}" Style="{StaticResource Headline}" />
            <Label Text="{DynamicResource native.dotnet.chatList.recent}" Style="{StaticResource Metadata}" />
        </VerticalStackLayout>

        <Border
            Grid.Row="1"
            Padding="12"
            BackgroundColor="#FEF2F2"
            Stroke="#FCA5A5"
            StrokeThickness="1"
            IsVisible="{Binding HasError}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Label Text="{Binding ErrorMessage}" TextColor="#991B1B" Style="{StaticResource Body}" />
        </Border>

        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Editor
                    x:Name="NewMessageEditor"
                    AutoSize="TextChanges"
                    Placeholder="{DynamicResource native.dotnet.chatList.startNew}"
                    MinimumHeightRequest="88"
                    MaxLength="32768" />
                <Button
                    Grid.Column="1"
                    Text="{DynamicResource native.dotnet.chatList.start}"
                    Clicked="OnStartClicked"
                    VerticalOptions="Start" />
            </Grid>

            <CollectionView
                Grid.Row="1"
                ItemsSource="{Binding Conversations}"
                RemainingItemsThreshold="2"
                RemainingItemsThresholdReached="OnRemainingItemsThresholdReached">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="8">
                        <Label Text="{DynamicResource native.dotnet.chatList.empty}" Style="{StaticResource Headline}" />
                        <Label Text="{DynamicResource native.dotnet.chatList.emptyDescription}" Style="{StaticResource Body}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="chat:ChatConversationRow">
                        <Border Margin="0,0,0,12" Padding="14" Stroke="#D8DEE9" StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding DisplayTitle}" Style="{StaticResource Headline}" />
                                <Label Text="{app:UiLocalizedValue Path=CreatedAt, Format=dateTime}" Style="{StaticResource Metadata}" />
                                <HorizontalStackLayout Spacing="8">
                                    <Button Text="{DynamicResource native.swift.communityActions.open}" Clicked="OnOpenClicked" CommandParameter="{Binding .}" />
                                    <Button Text="{DynamicResource native.swift.common.delete}" Clicked="OnDeleteClicked" CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <controls:HybridPaginationControl
                        x:Name="PaginationControl"
                        PaginationId="chat-list"
                        HasMore="{Binding HasMore}"
                        IsLoading="{Binding IsLoading}"
                        HasError="{Binding HasError}" />
                </CollectionView.Footer>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
