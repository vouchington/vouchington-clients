<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Voucha.Client.App.Pages.SupportThreadPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:app="clr-namespace:Voucha.Client.App"
    xmlns:chat="clr-namespace:Voucha.Client.Core.Chat;assembly=Voucha.Client.Core"
    x:DataType="chat:SupportThreadViewModel"
    Title="{DynamicResource native.dotnet.support.thread}">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="20" RowSpacing="16">
        <VerticalStackLayout Spacing="6">
            <Label Text="{Binding Title}" Style="{StaticResource Headline}" />
            <Label Text="{Binding ConversationId}" Style="{StaticResource Metadata}" />
        </VerticalStackLayout>

        <Border
            Grid.Row="1"
            Padding="12"
            BackgroundColor="#FEF2F2"
            Stroke="#FCA5A5"
            StrokeThickness="1"
            IsVisible="{Binding HasError}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Label Text="{Binding ErrorMessage}" TextColor="#991B1B" Style="{StaticResource Body}" />
        </Border>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Messages}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24" Spacing="8">
                    <Label Text="{DynamicResource native.dotnet.chatConversation.noMessages}" Style="{StaticResource Headline}" />
                    <Label Text="{DynamicResource native.dotnet.support.threadEmpty}" Style="{StaticResource Body}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="chat:SupportMessageRow">
                    <Border Margin="0,0,0,12" Padding="14" Stroke="#D8DEE9" StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding LocalizedDirection}" Style="{StaticResource Eyebrow}" />
                            <Label Text="{Binding UserContent}" Style="{StaticResource Body}" LineBreakMode="WordWrap" />
                            <Label Text="{app:UiLocalizedValue Path=CreatedAt, Format=dateTime}" Style="{StaticResource Metadata}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <HorizontalStackLayout Grid.Row="3" Spacing="8" HorizontalOptions="Center" IsVisible="{Binding HasMoreMessages}">
            <Button Text="{DynamicResource native.swift.common.loadMore}" Clicked="OnLoadMoreClicked" IsEnabled="{Binding HasMoreMessages}" />
            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
