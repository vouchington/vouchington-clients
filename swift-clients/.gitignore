# OS
.DS_Store

# Re-include app icons / asset catalogs that the root .gitignore globally ignores
# (root ignores *.png *.jpg *.jpeg *.webp *.gif *.tiff globally)
!**/*.png
!**/*.jpg
!**/*.jpeg
!**/*.webp
!**/*.gif
!**/*.tiff
!**/*.imageset/
!**/*.imageset/**
!**/*.appiconset/
!**/*.appiconset/**
!**/Assets.xcassets/**
